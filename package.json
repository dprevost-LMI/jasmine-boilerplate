{
  "name": "jasmine-boilerplate",
  "version": "1.0.0",
  "author": "Christian Bromann <christian@saucelabs.com>",
  "description": "Boilerplate project to run WebdriverIO tests with Jasmine",
  "license": "MIT",
  "homepage": "https://github.com/webdriverio/jasmine-boilerplate#readme",
  "type": "module",
  "keywords": [
    "webdriver",
    "webdriverio",
    "jasmine",
    "e2e",
    "selenium",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/jasmine-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/webdriverio/jasmine-boilerplate/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "wdio run wdio.local.conf.ts",
    "test:local": "wdio run wdio.local.conf.ts",
    "test:sauce": "wdio run wdio.sauce.conf.ts"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.8",
    "@wdio/cli": "^9.16.2",
    "@wdio/eslint": "^0.1.2",
    "@wdio/globals": "^9.16.2",
    "@wdio/jasmine-framework": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/sauce-service": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "webdriverio": "^9.16.2",
    "expect-webdriverio": "file:.yalc/expect-webdriverio"
  },
  "pnpm": {
    "overrides": {
      "expect-webdriverio": "file:.yalc/expect-webdriverio"
    }
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
